#!/usr/bin/env bash

# Rejects a commit subject that does not follow Conventional Commits. Installed
# by link-dotfiles.sh, which points core.hooksPath at this directory, because
# .git/hooks is not tracked and would otherwise have to be set up by hand on
# every machine.
#
# Bypass a single commit with `git commit --no-verify` when it genuinely does not
# fit the convention.

set -u

readonly TYPES='feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert'
readonly MESSAGE_FILE="${1:?usage: commit-msg <message-file>}"

# The subject is the first line that is neither blank nor a comment.
subject=''
while IFS= read -r line; do
  case $line in
    '#'*) continue ;;
    '') continue ;;
  esac
  subject=$line
  break
done < "$MESSAGE_FILE"

# Nothing to check: an empty message aborts the commit on its own. Merges,
# reverts and the fixup/squash family are generated by git itself.
case $subject in
  '' | 'Merge '* | 'Revert '* | 'fixup!'* | 'squash!'* | 'amend!'*) exit 0 ;;
esac

if [[ $subject =~ ^($TYPES)(\([a-z0-9./-]+\))?!?:\ .+ ]]; then
  exit 0
fi

cat >&2 <<MSG
commit-msg: subject must follow Conventional Commits

  $subject

Expected: <type>[(scope)][!]: <description>
Types: ${TYPES//|/ }

Bypass with --no-verify if this commit genuinely does not fit.
MSG
exit 1
